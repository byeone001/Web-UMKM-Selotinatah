{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0"
    }
  },
  "routes": [
    {
      "src": "/",
      "dest": "/api/index.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_URL": "https://umkmselotinatah.vercel.app",
    "CONFIG_CACHE": "/tmp/config.php",
    "EVENTS_CACHE": "/tmp/events.php",
    "PACKAGES_CACHE": "/tmp/packages.php",
    "ROUTES_CACHE": "/tmp/routes.php",
    "SERVICES_CACHE": "/tmp/services.php",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "LARAVEL_STORAGE_PATH": "/tmp/storage",
    "SESSION_DRIVER": "cookie",
    "CACHE_STORE": "file"
  }
}